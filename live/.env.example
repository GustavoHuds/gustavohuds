# ── Rede ─────────────────────────────────────────────────────────────────────
# Rede Docker onde estão o Uptime Kuma e o Caddy.  Descubra com:
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' uptime-kuma
MONITOR_NETWORK=monitor

# ── Uptime Kuma ──────────────────────────────────────────────────────────────
# Endereço INTERNO do Kuma na rede Docker (nome do container + porta). Nunca o público.
KUMA_URL=http://uptime-kuma:3001
# Kuma → Settings → API Keys → Generate. Só leitura do /metrics.
KUMA_API_KEY=

# Quais monitores aparecem no perfil, e com que nome público, na ordem de exibição.
# Formato: nome exato no Kuma=Nome público;outro=Outro
# Tudo que não estiver aqui NUNCA sai do servidor.  Para ver os nomes: ./deploy.sh check
MONITORS=beleads-api=BELeads;belponto-web=BELPonto;site=Website

# ── Opcional ─────────────────────────────────────────────────────────────────
# Liga o POST /ingest para o CI enviar "testes" e "deployed há X".  Vazio = desligado.
# Gere com: openssl rand -hex 32
INGEST_TOKEN=
# 1 = confiar no X-Forwarded-For do Caddy (limite por IP correto no /ingest)
TRUST_PROXY=1
# Intervalo de leitura do Kuma (s) e latência a partir da qual o sistema aparece como SLOW (ms)
POLL_SECONDS=60
SLOW_MS=1500
