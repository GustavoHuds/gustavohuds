# ── Fonte ────────────────────────────────────────────────────────────────────
# bot  = monitor-bot (o bot de Telegram): lê o SQLite dele só leitura. Mesmos
#        status que chegam no Telegram, e 30 dias de uptime desde o primeiro minuto.
# kuma = Uptime Kuma pelo /metrics.
SOURCE=bot

# ── Rede ─────────────────────────────────────────────────────────────────────
# Rede Docker onde o proxy (Caddy/Traefik) alcança o serviço; com SOURCE=kuma,
# também a rede do Kuma.  Ex.: coolify (Traefik do Coolify).  Descubra com:
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' <container do proxy>
MONITOR_NETWORK=coolify

# ── monitor-bot (SOURCE=bot) ─────────────────────────────────────────────────
# Pasta no HOST com o monitor.db do bot (volume de dados dele). Montada só leitura.
BOT_DATA_DIR=/var/lib/docker/volumes/monitor_bot-data/_data

# ── Uptime Kuma (SOURCE=kuma) ────────────────────────────────────────────────
# Endereço INTERNO do Kuma na rede Docker (nome do container + porta). Nunca o público.
KUMA_URL=http://uptime-kuma:3001
# Kuma → Settings → API Keys → Generate. Só leitura do /metrics.
KUMA_API_KEY=

# Quais sistemas aparecem no perfil, e com que nome público, na ordem de exibição.
# Formato: nome exato na fonte=Nome público;outro=Outro
#   bot:  o "nome" do [[app]] no monitor.toml do bot.   kuma: o nome do monitor.
# Tudo que não estiver aqui NUNCA sai do servidor.  Para ver os nomes: ./deploy.sh check
MONITORS=BELPonto=BELPonto;BELPreço=BELPreço;Belsite=Website

# ── Opcional ─────────────────────────────────────────────────────────────────
# Liga o POST /ingest para o CI enviar "testes" e "deployed há X".  Vazio = desligado.
# Gere com: openssl rand -hex 32
INGEST_TOKEN=
# 1 = confiar no X-Forwarded-For do Caddy (limite por IP correto no /ingest)
TRUST_PROXY=1
# Intervalo de leitura da fonte (s) e latência a partir da qual o sistema aparece como SLOW (ms)
POLL_SECONDS=60
SLOW_MS=1500
